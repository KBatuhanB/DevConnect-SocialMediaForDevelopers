{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "@devconnect/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@devconnect/shared/*": [
        "./packages/shared/src/*"
      ],
      "@web/*": [
        "./apps/web/src/*"
      ],
      "@api/*": [
        "./apps/api/src/*"
      ]
    }
  }
}